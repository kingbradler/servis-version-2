# =============================================================================
# SERVIS backend — example environment (FICTITIOUS values only)
# Copy to backend/.env and fill real secrets locally. Never commit .env.
# =============================================================================

# development | production (documentation only — settings module selects env)
DJANGO_ENV=development

DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string-min-32
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev default: SQLite when USE_SQLITE=true
USE_SQLITE=true
# Or PostgreSQL via discrete vars / Docker Compose:
# USE_SQLITE=false
# POSTGRES_DB=servis
# POSTGRES_USER=servis
# POSTGRES_PASSWORD=servis_dev_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Or a single URL (dev or prod):
# DATABASE_URL=postgres://servis:servis_dev_password@localhost:5432/servis

# --- CORS / CSRF (frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT cookies (HttpOnly — never expose to JS / never put in Next.js) ---
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
# Custom domain (www + api): set the parent so /admin is not bounced to login.
# JWT_COOKIE_DOMAIN=.servis-superrapid.com

# --- Storage ---
# local = backend/media + backend/private_media
# supabase = buckets below (SERVICE_KEY backend-only)
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=servis
SUPABASE_PRIVATE_BUCKET=servis-private

# --- Email ---
# Dev default: mails printed in the Django console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SERVIS <noreply@servis.local>
FRONTEND_URL=http://localhost:3000

# Resend (SMTP) — https://resend.com/api-keys
# 1) Create API key on Resend
# 2) For tests without a domain: DEFAULT_FROM_EMAIL=SERVIS <onboarding@resend.dev>
# 3) For prod: verify your domain, then use noreply@votredomaine.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxx
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=SERVIS <onboarding@resend.dev>
# FRONTEND_URL=http://localhost:3000

# =============================================================================
# Production checklist (use with DJANGO_SETTINGS_MODULE=config.settings.production)
# =============================================================================
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<strong-random-32+-chars>
# DJANGO_ALLOWED_HOSTS=api.example.com
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/servis
# CORS_TRUST_VERCEL=true
# CORS_ALLOWED_ORIGINS=https://www.example.com
# CSRF_TRUSTED_ORIGINS=https://www.example.com
# SERVIS_BOOTSTRAP=true   # premier déploiement sans Supabase / SMTP
# JWT_COOKIE_SECURE=true
# JWT_COOKIE_SAMESITE=None
# SECURE_SSL_REDIRECT=true
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=<service_role — never in frontend>
# SUPABASE_STORAGE_BUCKET=servis
# SUPABASE_PRIVATE_BUCKET=servis-private
# --- Email (REQUIRED in production — console backend is rejected) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_xxxxxxxxx
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=SERVIS <noreply@votredomaine.com>
# FRONTEND_URL=https://www.example.com
# Auth throttle rates (defaults in production): login 10/min, register 5/h,
# password-reset 3/h, resend-verification 3/h
