# SERVIS frontend — public config only (safe to expose in the browser)
# Copy to frontend/.env.local — never put Supabase service keys here.

# Django API base (includes /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Canonical app URL (metadata, redirects, absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mapbox public access token (Phase 6.5) — never commit the real value
NEXT_PUBLIC_MAPBOX_TOKEN=

# Production examples (fictitious):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#NEXT_PUBLIC_MAPBOX_TOKEN=